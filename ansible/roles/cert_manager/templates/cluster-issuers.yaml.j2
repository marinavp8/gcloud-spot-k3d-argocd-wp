{% for env, server in [('prod', 'https://acme-v02.api.letsencrypt.org/directory'),
                       ('staging', 'https://acme-staging-v02.api.letsencrypt.org/directory')] %}
---
apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: letsencrypt-{{ env }}
spec:
  acme:
    email: {{ acme_email }}
    server: {{ server }}
    privateKeySecretRef:
      name: letsencrypt-{{ env }}-account
    solvers:
      - http01:
          ingress:
            ingressClassName: traefik
{% endfor %}
